# Line endings: enforce LF for text, CRLF preserved only where Windows
# build hosts require it. Many DeadZone engines ship shell scripts that
# fail on Windows-style newlines, so we standardize on LF across the
# repo. The few legacy CRLF files explicitly opt in below.

*                text=auto eol=lf

# GitHub Actions workflow files always use LF.
.github/**       text eol=lf

# Shell scripts must remain LF; CRLF breaks our bash -n validation steps.
*.sh             text eol=lf

# Python source must be LF; CRLF wizards satisfy no one.
*.py             text eol=lf

# YAML, TOML, ENV, INI — configuration files.
*.yml            text eol=lf
*.yaml           text eol=lf
*.toml           text eol=lf
*.ini            text eol=lf
*.cfg            text eol=lf
*.conf           text eol=lf
*.env            text eol=lf

# Documentation: Markdown is text and stays LF.
*.md             text eol=lf
*.txt            text eol=lf

# Web files: HTML, CSS, JS — LF.
*.html           text eol=lf
*.css            text eol=lf
*.js             text eol=lf
*.cjs            text eol=lf
*.mjs            text eol=lf
*.ts             text eol=lf
*.tsx            text eol=lf
*.jsx            text eol=lf
*.json           text eol=lf

# Lockfiles are text but historically noisy under CRLF.
package-lock.json text eol=lf
pnpm-lock.yaml    text eol=lf
yarn.lock         text eol=lf
bun.lockb         binary

# Windows-only EXE in DeadZone-Fastboot artifact must remain binary
# even if uploaded to releases.
*.exe            binary
*.dll            binary
*.pyd            binary

# ROM artifacts must remain bit-identical across checkouts.
*.zip            binary
*.img            binary
*.tar            binary
*.tgz            binary
*.lz4           binary
*.zst           binary
*.gz            binary
*.bz2           binary
*.xz            binary
*.7z            binary
*.br            binary

# Images stay binary.
*.png           binary
*.jpg           binary
*.jpeg           binary
*.gif            binary
*.webp           binary
*.svg            text eol=lf

# Audio/video artifacts.
*.mp3            binary
*.mp4            binary
*.webm           binary
*.mov            binary
*.wav            binary
*.flac           binary
*.ogg            binary

# Android build outputs that must not be re-encoded.
*.apk            binary
*.aab            binary
*.jar            binary
*.so             binary
*.o              binary
*.a              binary
*.dex            binary
*.vdex           binary
*.art            binary
*.oat            binary

# Fonts and design assets.
*.ttf            binary
*.otf            binary
*.woff           binary
*.woff2          binary